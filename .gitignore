# Android build / generated artifacts
# NOTE: deliberately NOT ignoring android/** wholesale — that folder holds
# real source (AndroidManifest.xml, MainActivity, Gradle config, signing
# setup) that should stay tracked. Only generated/build output is ignored.
android/build/
android/app/debug/
android/app/profile/
android/app/release/
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/gradle-wrapper.jar
